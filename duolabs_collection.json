{
  "info": {
    "name": "Duolabs API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for testing Duolabs API endpoints"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth & Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"student1\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/register",
            "description": "Register a new user in Duolabs."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set(\"token\", data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"student1\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/login",
            "description": "Authenticate user and receive a JWT token. Automatically saves token to collection variable."
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/courses",
            "description": "Retrieve list of all courses."
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Go Programming\",\n  \"description\": \"Learn Go language fundamentals\",\n  \"difficulty\": \"beginner\"\n}"
            },
            "url": "{{baseUrl}}/courses",
            "description": "Create a new course (difficulty must be beginner, intermediate, or advanced)."
          }
        },
        {
          "name": "Get Course By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/courses/1",
            "description": "Get details of a specific course by ID."
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Advanced Go Programming\",\n  \"description\": \"Master Go concurrency and patterns\",\n  \"difficulty\": \"advanced\"\n}"
            },
            "url": "{{baseUrl}}/courses/1",
            "description": "Update an existing course by ID."
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/courses/1",
            "description": "Delete a course by ID."
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll in Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": 1\n}"
            },
            "url": "{{baseUrl}}/enrollments",
            "description": "Enroll authenticated user into a course (Requires Auth)."
          }
        },
        {
          "name": "Get All Enrollments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/enrollments",
            "description": "Get all course enrollments."
          }
        },
        {
          "name": "Get Enrollments by User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/enrollments/user/1",
            "description": "Get enrollments/courses for a specific user ID."
          }
        },
        {
          "name": "Get Enrollments by Course",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/enrollments/course/1",
            "description": "Get users enrolled in a specific course ID."
          }
        },
        {
          "name": "Unenroll",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/enrollments/1",
            "description": "Cancel an enrollment by ID (Requires Auth)."
          }
        }
      ]
    }
  ]
}